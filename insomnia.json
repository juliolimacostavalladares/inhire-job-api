      "modified": 1788180000000,
      "created": 1788180000000,
      "url": "{{ _.base_url }}/v1/auth/register",
      "name": "1. Registrar Candidato (Auto-salva candidate_token & user_id)",
      "method": "POST",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"candidato.teste@inhire.internal\",\n  \"password\": \"SenhaForte123!\",\n  \"role\": \"CANDIDATE\"\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "afterResponseScript": "try {\n  const res = insomnia.response.json();\n  if (res.accessToken) {\n    insomnia.environment.set('candidate_token', res.accessToken);\n    if (res.user && res.user.role === 'ADMIN') {\n      insomnia.environment.set('admin_token', res.accessToken);\n    }\n  }\n  if (res.refreshToken) {\n    insomnia.environment.set('candidate_refresh_token', res.refreshToken);\n    if (res.user && res.user.role === 'ADMIN') {\n      insomnia.environment.set('admin_refresh_token', res.refreshToken);\n    }\n  }\n  if (res.user && res.user.id) {\n    insomnia.environment.set('candidate_user_id', res.user.id);\n    if (res.user.role === 'ADMIN') {\n      insomnia.environment.set('admin_user_id', res.user.id);\n    }\n  }\n} catch (e) {\n  console.error('Error in after-response script', e);\n}",
      "metaSortKey": 201,
      "_type": "request"
    },
